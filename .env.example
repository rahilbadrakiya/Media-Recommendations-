# Copy this file to .env and fill in your keys
# Do NOT commit .env to GitHub

# TMDB API key — get free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Gemini API key — get free at https://aistudio.google.com/app/apikey
# Required for the AI chatbot feature
GEMINI_API_KEY=your_gemini_api_key_here

# CORS — comma-separated list of allowed frontend origins (production)
# Example: https://cinemate.example.com,https://www.cinemate.example.com
# Defaults to http://localhost:5173 if not set
ALLOWED_ORIGINS=
